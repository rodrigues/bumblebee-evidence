index 0000000..90e25f5
--- /dev/null
+++ b/lib/bumblebee/text/qwen3_5.ex
@@ -0,0 +1,1042 @@
+defmodule Bumblebee.Text.Qwen3_5 do
+  alias Bumblebee.Shared
+
+  options =
+    [
+      vocab_size: [
+        default: 248_320,
+        doc: """
+        the vocabulary size of the token embedding. This corresponds to the number of distinct
+        tokens that can be represented in model input and output
+        """
+      ],
+      max_positions: [
+        default: 262_144,
+        doc: """
+        the vocabulary size of the position embedding. This corresponds to the maximum sequence
+        length that this model can process. Typically this is set to a large value just in case,
+        such as 512, 1024 or 2048
+        """
+      ],
+      hidden_size: [
+        default: 1024,
+        doc: "the dimensionality of hidden layers"
+      ],
+      intermediate_size: [
+        default: 3584,
+        doc: "the dimensionality of intermediate layers"
+      ],
+      num_blocks: [
+        default: 24,
+        doc: "the number of blocks in the model"
+      ],
+      block_types: [
+        default: nil,
+        doc: """
+        the type of each block, either `:linear_attention` or `:full_attention`.
+        Defaults to `:full_attention` for every fourth block and `:linear_attention`
+        for the others
+        """
+      ],
+      num_attention_heads: [
+        default: 8,
+        doc: "the number of attention heads in the full attention blocks"
+      ],
+      num_key_value_heads: [
+        default: 2,
+        doc: "the number of key value heads in the full attention blocks"
+      ],
+      attention_head_size: [
+        default: 256,
+        doc:
+          "the size of the key, value, and query projection per head in the full attention blocks"
+      ],
+      linear_attention_num_key_heads: [
+        default: 16,
+        doc: "the number of query and key heads in the linear attention blocks"
+      ],
+      linear_attention_num_value_heads: [
+        default: 16,
+        doc: "the number of value heads in the linear attention blocks"
+      ],
+      linear_attention_key_head_size: [
+        default: 128,
+        doc: "the size of the query and key projection per head in the linear attention blocks"
+      ],
+      linear_attention_value_head_size: [
+        default: 128,
+        doc: "the size of the value projection per head in the linear attention blocks"
+      ],
+      linear_attention_conv_kernel_size: [
+        default: 4,
+        doc: "the size of the causal convolution kernel in the linear attention blocks"
+      ],
+      activation: [
+        default: :silu,
+        doc: "the activation function"
+      ],
+      rotary_embedding_base: [
+        default: 10_000_000,
+        doc: "base for computing rotary embedding frequency"
+      ],
+      rotary_embedding_percentage: [
+        default: 0.25,
+        doc: "percentage of each attention head to apply rotary embedding to"
+      ],
+      layer_norm_epsilon: [
+        default: 1.0e-6,
+        doc: "the epsilon used by RMS normalization layers"
+      ],
+      initializer_scale: [
+        default: 0.02,
+        doc:
+          "the standard deviation of the normal initializer used for initializing kernel parameters"
+      ],
+      tie_word_embeddings: [
+        default: true,
+        doc: "whether to tie input and output embedding weights"
+      ]
+    ] ++
+      Shared.common_options([:rotary_embedding_scaling_strategy]) ++
+      Shared.token_options(pad_token_id: 248_044)
+
+  @moduledoc """
+  Qwen3.5 model family, also used by Qwen3.6 and the dense Qwen3.8 models.
+
+  Most blocks use Gated DeltaNet linear attention, which keeps a
+  recurrent state of fixed size and a short convolution over recent
+  tokens, and every fourth block uses full attention with a gate on
+  its output.
+
+  Only the language model is supported. When loading a multimodal
+  checkpoint, the vision tower and the multi-token prediction weights
+  are ignored.
+
+  ## Architectures
+
+    * `:base` - plain Qwen3.5 without any head on top
+
+    * `:for_causal_language_modeling` - Qwen3.5 with a language modeling
+      head. The head returns logits for each token in the original
+      sequence
+
+  ## Inputs
+
+    * `"input_ids"` - `{batch_size, sequence_length}`
+
+      Indices of input sequence tokens in the vocabulary.
+
+    * `"attention_mask"` - `{batch_size, sequence_length}`
+
+      Mask indicating which tokens to attend to. This is used to ignore
+      padding tokens, which are added when processing a batch of sequences
+      with different length.
+
+    * `"position_ids"` - `{batch_size, sequence_length}`
+
+      Indices of positions of each input sequence tokens in the position
+      embeddings.
+
+    * `"input_embeddings"` - `{batch_size, sequence_length, hidden_size}`
+
+      Embedded representation of `"input_ids"`, which can be specified
+      for more control over how `"input_ids"` are embedded than the
+      model's internal embedding lookup. If `"input_embeddings"` are present,
+      then `"input_ids"` will be ignored.
+
+    * `"cache"`
+
+      A container with cached layer results used to speed up sequential
+      decoding (autoregression). With cache, certain hidden states are
+      taken from the cache, rather than recomputed on every decoding
+      pass. The cache should be treated as opaque and initialized with
+      `Bumblebee.Text.Generation.init_cache/4`.
+
+  ## Global layer options
+
+  #{Shared.global_layer_options_doc([:output_hidden_states, :output_attentions])}
+
+  ## Configuration
+
+  #{Shared.options_doc(options)}
+  """
+
+  defstruct [architecture: :base] ++ Shared.option_defaults(options)
+
+  @behaviour Bumblebee.ModelSpec
+  @behaviour Bumblebee.Configurable
+  @behaviour Bumblebee.Text.Generation
+
+  import Bumblebee.Utils.Model, only: [join: 2]
+  import Nx.Defn
+
+  alias Bumblebee.Layers
+
+  @impl true
+  def architectures(), do: [:base, :for_causal_language_modeling]
+
+  @impl true
+  def config(spec, opts) do
+    spec = Shared.put_config_attrs(spec, opts)
+
+    block_types =
+      spec.block_types ||
+        for index <- 0..(spec.num_blocks - 1) do
+          if rem(index + 1, 4) == 0, do: :full_attention, else: :linear_attention
+        end
+
+    if length(block_types) != spec.num_blocks do
+      raise ArgumentError,
+            "expected :block_types to have #{spec.num_blocks} entries, got: #{length(block_types)}"
+    end
+
+    %{spec | block_types: block_types}
+  end
+
+  @impl true
+  def input_template(_spec) do
+    %{
+      "input_ids" => Nx.template({1, 1}, :s64)
+    }
+  end
+
+  @impl true
+  def init_cache(spec, batch_size, max_length, _inputs) do
+    cache =
+      Layers.Decoder.init_cache(batch_size, max_length,
+        hidden_size: spec.hidden_size,
+        attention_head_size: spec.attention_head_size,
+        decoder_num_attention_heads: spec.num_attention_heads,
+        decoder_num_key_value_heads: spec.num_key_value_heads,
+        decoder_num_blocks: spec.num_blocks
+      )
+
+    # Linear attention blocks keep the convolution inputs of the last
+    # few tokens and the recurrent state, instead of keys and values
+    linear_attention = %{
+      conv_state:
+        Nx.broadcast(
+          0.0,
+          {batch_size, spec.linear_attention_conv_kernel_size - 1,
+           linear_attention_conv_size(spec)}
+        ),
+      recurrent_state:
+        Nx.broadcast(
+          0.0,
+          {batch_size, spec.linear_attention_num_value_heads, spec.linear_attention_key_head_size,
+           spec.linear_attention_value_head_size}
+        )
+    }
+
+    blocks =
+      cache.blocks
+      |> Tuple.to_list()
+      |> Enum.zip_with(spec.block_types, fn
+        block, :full_attention -> block
+        block, :linear_attention -> %{block | self_attention: linear_attention}
+      end)
+      |> List.to_tuple()
+
+    %{cache | blocks: blocks}
+  end
+
+  @impl true
+  def model(%__MODULE__{architecture: :base} = spec) do
+    inputs = inputs(spec)
+
+    inputs
+    |> core(spec)
+    |> Layers.output()
+  end
+
+  def model(%__MODULE__{architecture: :for_causal_language_modeling} = spec) do
+    inputs = inputs(spec)
+
+    outputs = core(inputs, spec)
+    logits = language_modeling_head(outputs.hidden_state, spec, name: "language_modeling_head")
+
+    Layers.output(%{
+      logits: logits,
+      hidden_states: outputs.hidden_states,
+      attentions: outputs.attentions,
+      cache: outputs.cache
+    })
+  end
+
+  defp inputs(spec) do
+    shape = {nil, nil}
+    hidden_shape = {nil, nil, spec.hidden_size}
+
+    Bumblebee.Utils.Model.inputs_to_map([
+      Axon.input("input_ids", optional: true, shape: shape),
+      Axon.input("attention_mask", optional: true, shape: shape),
+      Axon.input("position_ids", optional: true, shape: shape),
+      Axon.input("input_embeddings", optional: true, shape: hidden_shape),
+      Axon.input("cache", optional: true)
+    ])
+  end
+
+  defp core(inputs, spec) do
+    embeddings =
+      Layers.default inputs["input_embeddings"] do
+        Axon.embedding(inputs["input_ids"], spec.vocab_size, spec.hidden_size,
+          kernel_initializer: kernel_initializer(spec),
+          name: "embedder.token_embedding"
+        )
+      end
+
+    position_ids =
+      Layers.default inputs["position_ids"] do
+        Layers.default_position_ids(embeddings)
+      end
+
+    decoder_outputs =
+      decoder(
+        embeddings,
+        position_ids,
+        inputs["attention_mask"],
+        inputs["cache"],
+        spec,
+        name: "decoder"
+      )
+
+    hidden_state = rms_norm(decoder_outputs.hidden_state, spec, name: "output_norm")
+
+    %{
+      hidden_state: hidden_state,
+      hidden_states: Layers.append(decoder_outputs.hidden_states, hidden_state),
+      attentions: decoder_outputs.attentions,
+      cache: decoder_outputs.cache
+    }
+  end
+
+  defp decoder(hidden_state, position_ids, attention_mask, cache, spec, opts) do
+    name = opts[:name]
+
+    Layers.Transformer.blocks(
+      hidden_state,
+      [
+        num_blocks: spec.num_blocks,
+        attention_mask: attention_mask,
+        cache: cache,
+        name: join(name, "blocks")
+      ],
+      fn hidden_state, block ->
+        name = block.name
+
+        shortcut = hidden_state
+
+        normalized = rms_norm(hidden_state, spec, name: join(name, "self_attention_norm"))
+
+        {hidden_state, attention, self_attention_cache} =
+          case Enum.fetch!(spec.block_types, block.index) do
+            :full_attention ->
+              gated_attention(normalized, position_ids, block, spec,
+                name: join(name, "self_attention")
+              )
+
+            :linear_attention ->
+              {hidden_state, cache} =
+                gated_delta_net(normalized, attention_mask, block.self_attention_cache, spec,
+                  name: join(name, "linear_attention")
+                )
+
+              {hidden_state, Layers.none(), cache}
+          end
+
+        hidden_state = Axon.add(hidden_state, shortcut)
+
+        shortcut = hidden_state
+
+        hidden_state =
+          hidden_state
+          |> rms_norm(spec, name: join(name, "output_norm"))
+          |> Layers.Transformer.gated_ffn(spec.intermediate_size, spec.hidden_size,
+            activation: spec.activation,
+            name: join(name, "ffn")
+          )
+          |> Axon.add(shortcut)
+
+        %{
+          hidden_state: hidden_state,
+          attention: attention,
+          self_attention_cache: self_attention_cache
+        }
+      end
+    )
+  end
+
+  # Full attention, with a sigmoid gate on the output computed from the
+  # same projection as the query
+  defp gated_attention(hidden_state, position_ids, block, spec, opts) do
+    name = opts[:name]
+    head_size = spec.attention_head_size
+
+    query_and_gate =
+      Layers.Transformer.project_heads(hidden_state, spec.num_attention_heads, 2 * head_size,
+        use_bias: false,
+        kernel_initializer: kernel_initializer(spec),
+        name: join(name, "query")
+      )
+
+    query = Axon.nx(query_and_gate, & &1[[.., .., .., 0..(head_size - 1)//1]])
+
+    gate =
+      query_and_gate
+      |> Axon.nx(& &1[[.., .., .., head_size..-1//1]])
+      |> Layers.flatten_trailing()
+
+    project = fn suffix ->
+      Layers.Transformer.project_heads(hidden_state, spec.num_key_value_heads, head_size,
+        use_bias: false,
+        kernel_initializer: kernel_initializer(spec),
+        name: join(name, suffix)
+      )
+    end
+
+    key = project.("key")
+    value = project.("value")
+
+    query = rms_norm(query, spec, name: join(name, "query_norm"))
+    key = rms_norm(key, spec, name: join(name, "key_norm"))
+
+    # Multimodal rotary embedding splits positions into time, height and
+    # width sections, which all match for text, so it reduces to the 1D one
+    {query, key} =
+      Layers.Transformer.rotary_embedding(
+        query,
+        key,
+        block.attention_mask,
+        head_size,
+        [
+          position_ids: position_ids,
+          max_positions: spec.max_positions,
+          base: spec.rotary_embedding_base,
+          scaling_strategy: spec.rotary_embedding_scaling_strategy,
+          percentage: spec.rotary_embedding_percentage
+        ],
+        name: join(name, "rotary_embedding")
+      )
+
+    {key, value, attention_cache} =
+      Layers.Decoder.cached_attention_key_values(
+        key,
+        value,
+        block.self_attention_cache,
+        block.offset
+      )
+
+    num_key_value_groups = div(spec.num_attention_heads, spec.num_key_value_heads)
+    key = Layers.Transformer.repeat_heads(key, num_key_value_groups)
+    value = Layers.Transformer.repeat_heads(value, num_key_value_groups)
+
+    {attention_output, attention_weights} =
+      Layers.attention(
+        query,
+        key,
+        value,
+        block.attention_mask,
+        block.attention_head_mask,
+        Layers.none(),
+        block.offset,
+        causal: true
+      )
+
+    attention_output =
+      attention_output
+      |> Layers.flatten_trailing()
+      |> Axon.multiply(Axon.sigmoid(gate))
+      |> Axon.dense(spec.hidden_size,
+        use_bias: false,
+        kernel_initializer: kernel_initializer(spec),
+        name: join(name, "output")
+      )
+
+    {attention_output, attention_weights, attention_cache}
+  end
+
+  # Gated DeltaNet linear attention, see https://arxiv.org/abs/2412.06464
+  defp gated_delta_net(hidden_state, attention_mask, cache, spec, opts) do
+    name = opts[:name]
+
+    num_key_heads = spec.linear_attention_num_key_heads
+    num_value_heads = spec.linear_attention_num_value_heads
+    key_head_size = spec.linear_attention_key_head_size
+    value_head_size = spec.linear_attention_value_head_size
+    key_size = num_key_heads * key_head_size
+    value_size = num_value_heads * value_head_size
+
+    # Padding positions must not contribute to the convolution or the
+    # recurrent state
+    hidden_state =
+      Layers.if_present attention_mask do
+        Axon.layer(
+          fn hidden_state, attention_mask, _opts ->
+            attention_mask =
+              attention_mask |> Nx.new_axis(-1) |> Nx.as_type(Nx.type(hidden_state))
+
+            Nx.multiply(hidden_state, attention_mask)
+          end,
+          [hidden_state, attention_mask]
+        )
+      else
+        hidden_state
+      end
+
+    dense = fn units, suffix ->
+      Axon.dense(hidden_state, units,
+        use_bias: false,
+        kernel_initializer: kernel_initializer(spec),
+        name: join(name, suffix)
+      )
+    end
+
+    query_key_value = dense.(2 * key_size + value_size, "query_key_value")
+    output_gate = dense.(value_size, "output_gate")
+    beta = dense.(num_value_heads, "beta")
+    decay = dense.(num_value_heads, "decay")
+
+    {query_key_value, cache} =
+      causal_conv(query_key_value, cache, spec, name: join(name, "conv"))
+
+    query_key_value = Axon.activation(query_key_value, spec.activation)
+
+    split_heads = fn x, from, size, head_size ->
+      x
+      |> Axon.nx(&Nx.slice_along_axis(&1, from, size, axis: -1))
+      |> Layers.split_heads(div(size, head_size))
+    end
+
+    query = split_heads.(query_key_value, 0, key_size, key_head_size)
+    key = split_heads.(query_key_value, key_size, key_size, key_head_size)
+    value = split_heads.(query_key_value, 2 * key_size, value_size, value_head_size)
+
+    a_log = Axon.param("a_log", {num_value_heads}, initializer: :zeros)
+    dt_bias = Axon.param("dt_bias", {num_value_heads}, initializer: :ones)
+
+    {output, cache} =
+      Axon.layer(
+        &gated_delta_rule_impl/9,
+        [query, key, value, beta, decay, a_log, dt_bias, Axon.optional(cache)],
+        name: join(name, "delta_rule"),
+        num_value_heads: num_value_heads,
+        op_name: :gated_delta_rule
+      )
+      |> Layers.unwrap_tuple(2)
+
+    output =
+      Axon.layer(
+        &gated_rms_norm_impl/4,
+        [
+          output,
+          Layers.split_heads(output_gate, num_value_heads),
+          Axon.param("weight", {value_head_size}, initializer: :ones)
+        ],
+        name: join(name, "norm"),
+        epsilon: spec.layer_norm_epsilon,
+        op_name: :gated_rms_norm
+      )
+      |> Layers.flatten_trailing()
+      |> Axon.dense(spec.hidden_size,
+        use_bias: false,
+        kernel_initializer: kernel_initializer(spec),
+        name: join(name, "output")
+      )
+
+    {output, cache}
+  end
+
+  defp causal_conv(input, cache, spec, opts) do
+    kernel_size = spec.linear_attention_conv_kernel_size
+
+    kernel =
+      Axon.param("kernel", {linear_attention_conv_size(spec), kernel_size},
+        initializer: kernel_initializer(spec)
+      )
+
+    Axon.layer(&causal_conv_impl/4, [input, kernel, Axon.optional(cache)],
+      name: opts[:name],
+      op_name: :causal_conv
+    )
+    |> Layers.unwrap_tuple(2)
+  end
+
+  deftransformp causal_conv_impl(input, kernel, cache, _opts \\ []) do
+    {channels, kernel_size} = Nx.shape(kernel)
+    {batch_size, sequence_length, ^channels} = Nx.shape(input)
+
+    # The convolution sees the inputs of the preceding tokens, which are
+    # kept in the cache, or zeros at the start of the sequence
+    {window, cache} =
+      case cache do
+        %Axon.None{} ->
+          {Nx.broadcast(
+             Nx.tensor(0, type: Nx.type(input)),
+             {batch_size, kernel_size - 1, channels}
+           ), cache}
+
+        %{conv_state: conv_state} ->
+          {Nx.as_type(conv_state, Nx.type(input)), cache}
+      end
+
+    full_input = Nx.concatenate([window, input], axis: 1)
+
+    output =
+      0..(kernel_size - 1)
+      |> Enum.map(fn offset ->
+        full_input
+        |> Nx.slice_along_axis(offset, sequence_length, axis: 1)
+        |> Nx.multiply(kernel[[.., offset]])
+      end)
+      |> Enum.reduce(&Nx.add/2)
+
+    cache =
+      case cache do
+        %Axon.None{} ->
+          cache
+
+        %{conv_state: conv_state} = cache ->
+          window = Nx.slice_along_axis(full_input, sequence_length, kernel_size - 1, axis: 1)
+          %{cache | conv_state: Nx.as_type(window, Nx.type(conv_state))}
+      end
+
+    {output, cache}
+  end
+
+  deftransformp gated_delta_rule_impl(
+                  query,
+                  key,
+                  value,
+                  beta,
+                  decay,
+                  a_log,
+                  dt_bias,
+                  cache,
+                  opts \\ []
+                ) do
+    num_value_heads = opts[:num_value_heads]
+    type = Nx.type(value)
+    {batch_size, _sequence_length, num_key_heads, key_head_size} = Nx.shape(key)
+    value_head_size = Nx.axis_size(value, -1)
+
+    # Each query and key head serves consecutive value heads
+    repeat = div(num_value_heads, num_key_heads)
+    query = Bumblebee.Utils.Nx.repeat_interleave(query, repeat, axis: 2)
+    key = Bumblebee.Utils.Nx.repeat_interleave(key, repeat, axis: 2)
+
+    beta = Nx.sigmoid(Nx.as_type(beta, :f32))
+
+    decay = decay(decay, a_log, dt_bias)
+
+    state =
+      case cache do
+        %Axon.None{} ->
+          Nx.broadcast(0.0, {batch_size, num_value_heads, key_head_size, value_head_size})
+
+        %{recurrent_state: recurrent_state} ->
+          Nx.as_type(recurrent_state, :f32)
+      end
+
+    {output, state} =
+      gated_delta_rule(
+        Nx.as_type(query, :f32),
+        Nx.as_type(key, :f32),
+        Nx.as_type(value, :f32),
+        beta,
+        decay,
+        state
+      )
+
+    cache =
+      case cache do
+        %Axon.None{} ->
+          cache
+
+        %{recurrent_state: recurrent_state} = cache ->
+          %{cache | recurrent_state: Nx.as_type(state, Nx.type(recurrent_state))}
+      end
+
+    {Nx.as_type(output, type), cache}
+  end
+
+  defnp decay(decay, a_log, dt_bias) do
+    x = Nx.as_type(decay, :f32) + Nx.as_type(dt_bias, :f32)
+    # Matches torch.nn.functional.softplus, which is linear above 20
+    softplus = Nx.select(x > 20, x, Nx.log1p(Nx.exp(x)))
+    -Nx.exp(Nx.as_type(a_log, :f32)) * softplus
+  end
+
+  @chunk_size 64
+
+  # Decoding a single token needs one step of the recurrence, while longer
+  # inputs are processed in chunks, as in the chunked form of the reference
+  # implementation
+  deftransformp gated_delta_rule(query, key, value, beta, decay, state) do
+    sequence_length = Nx.axis_size(value, 1)
+
+    if sequence_length == 1 do
+      gated_delta_rule_single(query, key, value, beta, decay, state)
+    else
+      padding = rem(@chunk_size - rem(sequence_length, @chunk_size), @chunk_size)
+      gated_delta_rule_chunked(query, key, value, beta, decay, state, padding: padding)
+    end
+  end
+
+  defnp gated_delta_rule_single(query, key, value, beta, decay, state) do
+    {query, key} = normalize_query_key(query, key)
+
+    {output, state} =
+      delta_step(
+        Nx.squeeze(query, axes: [1]),
+        Nx.squeeze(key, axes: [1]),
+        Nx.squeeze(value, axes: [1]),
+        Nx.squeeze(beta, axes: [1]),
+        Nx.squeeze(decay, axes: [1]),
+        state
+      )
+
+    {Nx.new_axis(output, 1), state}
+  end
+
+  # Within a chunk, the delta rule updates are condensed into matrix
+  # products by solving a unit lower triangular system, so the loop runs
+  # once per chunk instead of once per token
+  defnp gated_delta_rule_chunked(query, key, value, beta, decay, state, opts \\ []) do
+    opts = keyword!(opts, [:padding])
+    {query, key} = normalize_query_key(query, key)
+    {batch_size, sequence_length, num_heads, value_head_size} = Nx.shape(value)
+
+    query = to_chunks(query, opts[:padding])
+    key = to_chunks(key, opts[:padding])
+    value = to_chunks(value, opts[:padding])
+    beta = to_chunks(beta, opts[:padding])
+    decay = to_chunks(decay, opts[:padding])
+
+    key_beta = key * Nx.new_axis(beta, -1)
+    value_beta = value * Nx.new_axis(beta, -1)
+
+    # The decay accumulated from the start of the chunk to each position,
+    # and between each pair of positions
+    cumulative_decay = Nx.cumulative_sum(decay, axis: 3)
+
+    lower =
+      Nx.greater_equal(
+        Nx.iota({@chunk_size, @chunk_size}, axis: 0),
+        Nx.iota({@chunk_size, @chunk_size}, axis: 1)
+      )
+
+    pairwise = Nx.new_axis(cumulative_decay, 4) - Nx.new_axis(cumulative_decay, 3)
+
+    pairwise_decay =
+      Nx.exp(Nx.select(Nx.broadcast(lower, pairwise), pairwise, Nx.Constants.neg_infinity(:f32)))
+
+    system = Nx.dot(key_beta, [4], [0, 1, 2], key, [4], [0, 1, 2]) * pairwise_decay
+    intra_chunk = Nx.dot(query, [4], [0, 1, 2], key, [4], [0, 1, 2]) * pairwise_decay
+    inverse = unit_lower_triangular_inverse(system)
+
+    new_values = Nx.dot(inverse, [4], [0, 1, 2], value_beta, [3], [0, 1, 2])
+    decayed_key_beta = key_beta * Nx.new_axis(Nx.exp(cumulative_decay), -1)
+    key_cumulative_decay = Nx.dot(inverse, [4], [0, 1, 2], decayed_key_beta, [3], [0, 1, 2])
+
+    last_decay = Nx.slice_along_axis(cumulative_decay, @chunk_size - 1, 1, axis: 3)
+    query = query * Nx.new_axis(Nx.exp(cumulative_decay), -1)
+    key = key * Nx.new_axis(Nx.exp(last_decay - cumulative_decay), -1)
+    chunk_decay = Nx.new_axis(Nx.exp(last_decay), -1)
+
+    {output, state} =
+      chunk_scan(query, key, new_values, key_cumulative_decay, intra_chunk, chunk_decay, state)
+
+    output =
+      output
+      |> Nx.reshape({batch_size, num_heads, :auto, value_head_size})
+      |> Nx.slice_along_axis(0, sequence_length, axis: 2)
+      |> Nx.transpose(axes: [0, 2, 1, 3])
+
+    {output, state}
+  end
+
+  # Moves the heads before the sequence, pads the sequence to whole chunks
+  # and splits it into chunks
+  deftransformp to_chunks(tensor, padding) do
+    [batch_size, sequence_length, num_heads | rest] = tensor |> Nx.shape() |> Tuple.to_list()
+    axes = [0, 2, 1 | Enum.drop(Nx.axes(tensor), 3)]
+
+    padding_config = [
+      {0, 0, 0},
+      {0, 0, 0},
+      {0, padding, 0} | Enum.map(rest, fn _ -> {0, 0, 0} end)
+    ]
+
+    num_chunks = div(sequence_length + padding, @chunk_size)
+
+    tensor
+    |> Nx.transpose(axes: axes)
+    |> Nx.pad(0.0, padding_config)
+    |> Nx.reshape(List.to_tuple([batch_size, num_heads, num_chunks, @chunk_size | rest]))
+  end
+
+  # The number of chunks is known when building the graph, so the loop is
+  # unrolled into a single graph
+  deftransformp chunk_scan(
+                  query,
+                  key,
+                  new_values,
+                  key_cumulative_decay,
+                  intra_chunk,
+                  chunk_decay,
+                  state
+                ) do
+    num_chunks = Nx.axis_size(new_values, 2)
+
+    {outputs, state} =
+      Enum.map_reduce(0..(num_chunks - 1), state, fn index, state ->
+        take = &(&1 |> Nx.slice_along_axis(index, 1, axis: 2) |> Nx.squeeze(axes: [2]))
+
+        delta =
+          Nx.subtract(
+            take.(new_values),
+            Nx.dot(take.(key_cumulative_decay), [3], [0, 1], state, [2], [0, 1])
+          )
+
+        output =
+          Nx.add(
+            Nx.dot(take.(query), [3], [0, 1], state, [2], [0, 1]),
+            Nx.dot(take.(intra_chunk), [3], [0, 1], delta, [2], [0, 1])
+          )
+
+        state =
+          Nx.add(
+            Nx.multiply(state, take.(chunk_decay)),
+            Nx.dot(take.(key), [2], [0, 1], delta, [2], [0, 1])
+          )
+
+        {output, state}
+      end)
+
+    {Nx.stack(outputs, axis: 2), state}
+  end
+
+  # The inverse of the identity plus the strictly lower part L of each
+  # matrix. L is nilpotent, so the inverse is the finite series
+  # I - L + L^2 - ..., computed as (I - L)(I + L^2)(I + L^4)...
+  deftransformp unit_lower_triangular_inverse(system) do
+    size = Nx.axis_size(system, -1)
+    strictly_lower = Nx.greater(Nx.iota({size, size}, axis: 0), Nx.iota({size, size}, axis: 1))
+    power = Nx.negate(Nx.select(Nx.broadcast(strictly_lower, system), system, 0.0))
+    identity = Nx.eye(size)
+    steps = ceil(:math.log2(size)) - 1
+
+    {inverse, _power} =
+      Enum.reduce(1..steps, {Nx.add(identity, power), power}, fn _, {inverse, power} ->
+        power = batched_matmul(power, power)
+        {batched_matmul(inverse, Nx.add(identity, power)), power}
+      end)
+
+    inverse
+  end
+
+  deftransformp batched_matmul(left, right) do
+    Nx.dot(left, [4], [0, 1, 2], right, [3], [0, 1, 2])
+  end
+
+  defnp normalize_query_key(query, key) do
+    {l2_normalize(query) / Nx.sqrt(Nx.axis_size(query, -1)), l2_normalize(key)}
+  end
+
+  defnp delta_step(q, k, v, b, d, state) do
+    state = state * (d |> Nx.exp() |> Nx.new_axis(-1) |> Nx.new_axis(-1))
+    memory = Nx.sum(state * Nx.new_axis(k, -1), axes: [2])
+    delta = (v - memory) * Nx.new_axis(b, -1)
+    state = state + Nx.new_axis(k, -1) * Nx.new_axis(delta, 2)
+    {Nx.sum(state * Nx.new_axis(q, -1), axes: [2]), state}
+  end
+
+  defnp l2_normalize(x) do
+    x * Nx.rsqrt(Nx.sum(x * x, axes: [-1], keep_axes: true) + 1.0e-6)
+  end
+
+  defnp gated_rms_norm_impl(input, gate, weight, opts \\ []) do
+    opts = keyword!(opts, epsilon: 1.0e-6, mode: :inference)
+    type = Nx.type(input)
+
+    input = Nx.as_type(input, :f32)
+    variance = Nx.mean(input * input, axes: [-1], keep_axes: true)
+    normalized = Nx.as_type(input * Nx.rsqrt(variance + opts[:epsilon]), type)
+
+    gate = Nx.as_type(gate, :f32)
+    Nx.as_type(weight * normalized * (gate * Nx.sigmoid(gate)), type)
+  end
+
+  defp rms_norm(hidden_state, spec, opts) do
+    Layers.rms_norm(hidden_state,
+      name: opts[:name],
+      shift: 1.0,
+      epsilon: spec.layer_norm_epsilon,
+      upcast: :all,
+      initializer: :zeros
+    )
+  end
+
+  defp language_modeling_head(hidden_state, spec, opts) do
+    name = opts[:name]
+
+    Layers.dense_transposed(hidden_state, spec.vocab_size,
+      kernel_initializer: kernel_initializer(spec),
+      name: join(name, "output")
+    )
+  end
+
+  defp linear_attention_conv_size(spec) do
+    2 * spec.linear_attention_num_key_heads * spec.linear_attention_key_head_size +
+      spec.linear_attention_num_value_heads * spec.linear_attention_value_head_size
+  end
+
+  defp kernel_initializer(spec) do
+    Axon.Initializers.normal(scale: spec.initializer_scale)
+  end
+
+  defimpl Bumblebee.HuggingFace.Transformers.Config do
+    def load(spec, data) do
+      import Shared.Converters
+
+      # Multimodal checkpoints nest the language model configuration
+      data =
+        case data do
+          %{"text_config" => text_data} ->
+            Map.put_new(text_data, "tie_word_embeddings", data["tie_word_embeddings"])
+
+          data ->
+            data
+        end
+
+      # Qwen3.5 configurations set unused token ids to null
+      data =
+        Map.reject(data, fn {key, value} ->
+          key in ["pad_token_id", "bos_token_id", "eos_token_id"] and value == nil
+        end)
+
+      opts =
+        convert!(data,
+          vocab_size: {"vocab_size", number()},
+          tie_word_embeddings: {"tie_word_embeddings", boolean()},
+          max_positions: {"max_position_embeddings", number()},
+          hidden_size: {"hidden_size", number()},
+          num_blocks: {"num_hidden_layers", number()},
+          block_types:
+            {"layer_types",
+             list(
+               mapping(%{
+                 "linear_attention" => :linear_attention,
+                 "full_attention" => :full_attention
+               })
+             )},
+          num_attention_heads: {"num_attention_heads", number()},
+          num_key_value_heads: {"num_key_value_heads", number()},
+          attention_head_size: {"head_dim", number()},
+          linear_attention_num_key_heads: {"linear_num_key_heads", number()},
+          linear_attention_num_value_heads: {"linear_num_value_heads", number()},
+          linear_attention_key_head_size: {"linear_key_head_dim", number()},
+          linear_attention_value_head_size: {"linear_value_head_dim", number()},
+          linear_attention_conv_kernel_size: {"linear_conv_kernel_dim", number()},
+          intermediate_size: {"intermediate_size", number()},
+          activation: {"hidden_act", activation()},
+          initializer_scale: {"initializer_range", number()},
+          layer_norm_epsilon: {"rms_norm_eps", number()}
+        ) ++
+          Shared.rotary_embedding_options_from_transformers(data) ++
+          Shared.common_options_from_transformers(data, spec)
+
+      @for.config(spec, opts)
+    end
+  end
+
+  defimpl Bumblebee.HuggingFace.Transformers.Model do
+    def params_mapping(spec) do
+      # Text-only, multimodal and MLX checkpoints store the language
+      # model under different prefixes. Without a head, the prefix is
+      # inferred on load, which also covers the unprefixed base checkpoint
+      layer =
+        case spec.architecture do
+          :base ->
+            fn name -> [name] end
+
+          :for_causal_language_modeling ->
+            fn name ->
+              [
+                "model." <> name,
+                "model.language_model." <> name,
+                "language_model.model." <> name
+              ]
+            end
+        end
+
+      # MLX checkpoints store these norm weights with the shift of 1
+      # added, and the convolution kernel as {channels, kernel_size, 1}
+      # instead of {channels, 1, kernel_size}. As in mlx-lm, the kernel
+      # layout tells the two apart
+      norm = fn name ->
+        %{
+          "weight" =>
+            {[
+               param_refs(layer.(name), "weight"),
+               param_refs(layer.("layers.0.linear_attn.conv1d"), "weight")
+             ],
+             fn [weight, conv_kernel] ->
+               if Nx.axis_size(conv_kernel, -1) == 1, do: Nx.subtract(weight, 1), else: weight
+             end}
+        }
+      end
+
+      mapping = %{
+        "embedder.token_embedding" => layer.("embed_tokens"),
+        "decoder.blocks.{n}.self_attention_norm" => norm.("layers.{n}.input_layernorm"),
+        "decoder.blocks.{n}.self_attention.query" => layer.("layers.{n}.self_attn.q_proj"),
+        "decoder.blocks.{n}.self_attention.key" => layer.("layers.{n}.self_attn.k_proj"),
+        "decoder.blocks.{n}.self_attention.value" => layer.("layers.{n}.self_attn.v_proj"),
+        "decoder.blocks.{n}.self_attention.output" => layer.("layers.{n}.self_attn.o_proj"),
+        "decoder.blocks.{n}.self_attention.query_norm" => norm.("layers.{n}.self_attn.q_norm"),
+        "decoder.blocks.{n}.self_attention.key_norm" => norm.("layers.{n}.self_attn.k_norm"),
+        "decoder.blocks.{n}.linear_attention.query_key_value" =>
+          layer.("layers.{n}.linear_attn.in_proj_qkv"),
+        "decoder.blocks.{n}.linear_attention.output_gate" =>
+          layer.("layers.{n}.linear_attn.in_proj_z"),
+        "decoder.blocks.{n}.linear_attention.beta" => layer.("layers.{n}.linear_attn.in_proj_b"),
+        "decoder.blocks.{n}.linear_attention.decay" => layer.("layers.{n}.linear_attn.in_proj_a"),
+        "decoder.blocks.{n}.linear_attention.conv" => %{
+          "kernel" =>
+            {[param_refs(layer.("layers.{n}.linear_attn.conv1d"), "weight")],
+             fn [kernel] ->
+               {channels, _, _} = Nx.shape(kernel)
+               Nx.reshape(kernel, {channels, :auto})
+             end}
+        },
+        "decoder.blocks.{n}.linear_attention.delta_rule" => %{
+          "a_log" => {[param_refs(layer.("layers.{n}.linear_attn"), "A_log")], fn [x] -> x end},
+          "dt_bias" =>
+            {[param_refs(layer.("layers.{n}.linear_attn"), "dt_bias")], fn [x] -> x end}
+        },
+        "decoder.blocks.{n}.linear_attention.norm" => layer.("layers.{n}.linear_attn.norm"),
+        "decoder.blocks.{n}.linear_attention.output" => layer.("layers.{n}.linear_attn.out_proj"),
+        "decoder.blocks.{n}.ffn.gate" => layer.("layers.{n}.mlp.gate_proj"),
+        "decoder.blocks.{n}.ffn.intermediate" => layer.("layers.{n}.mlp.up_proj"),
+        "decoder.blocks.{n}.ffn.output" => layer.("layers.{n}.mlp.down_proj"),
+        "decoder.blocks.{n}.output_norm" => norm.("layers.{n}.post_attention_layernorm"),
+        "output_norm" => norm.("norm"),
+        "language_modeling_head.output" =>
+          if(spec.tie_word_embeddings,
+            do: layer.("embed_tokens"),
+            else: ["lm_head", "language_model.lm_head"]
+          )
+      }
+
+      case spec.architecture do
+        :base -> Map.delete(mapping, "language_modeling_head.output")
+        :for_causal_language_modeling -> mapping
+      end
+    end
+
+    defp param_refs(layer_names, param_name) do
+      for layer_name <- layer_names, do: {layer_name, param_name}
+    end
+  end
+end
