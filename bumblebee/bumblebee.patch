diff --git a/lib/bumblebee/layers.ex b/lib/bumblebee/layers.ex
index 0681fa5..9b0e82f 100644
--- a/lib/bumblebee/layers.ex
+++ b/lib/bumblebee/layers.ex
@@ -38,13 +38,15 @@ defmodule Bumblebee.Layers do
 
     x = Nx.reshape(x, {num_tokens, hidden_size})
 
-    probabilities =
-      router_logits
-      |> Nx.reshape({num_tokens, num_experts})
-      |> Nx.as_type(:f32)
-      |> Axon.Activations.softmax(axis: -1)
+    router_logits = router_logits |> Nx.reshape({num_tokens, num_experts}) |> Nx.as_type(:f32)
+
+    scores =
+      case opts[:router_activation] do
+        :softmax -> Axon.Activations.softmax(router_logits, axis: -1)
+        :sigmoid -> Axon.Activations.sigmoid(router_logits)
+      end
 
-    {weights, experts} = Nx.top_k(probabilities, k: k)
+    {weights, experts} = Nx.top_k(scores, k: k)
 
     weights =
       if opts[:normalize_top_k],
@@ -60,31 +62,35 @@ defmodule Bumblebee.Layers do
     # gathered, which backends can do without unpacking them
     output =
       if num_tokens * k <= num_experts or Nx.Type.integer?(Nx.type(gate)) do
-        routed_experts(x, weights, experts, gate, intermediate, output, activation)
+        routed_experts(x, weights, experts, gate, intermediate, output, activation, opts)
       else
-        all_experts(x, weights, experts, gate, intermediate, output, activation)
+        all_experts(x, weights, experts, gate, intermediate, output, activation, opts)
       end
 
     Nx.reshape(output, {batch_size, sequence_length, :auto})
   end
 
-  defp routed_experts(x, weights, experts, gate, intermediate, output, activation) do
+  defp routed_experts(x, weights, experts, gate, intermediate, output, activation, opts) do
     {num_tokens, k} = Nx.shape(experts)
     experts = Nx.reshape(experts, {num_tokens * k})
     x = x |> Nx.new_axis(1) |> Nx.broadcast({num_tokens, k, Nx.axis_size(x, 1)})
     x = Nx.reshape(x, {num_tokens * k, :auto})
+    weights = Nx.reshape(weights, {num_tokens * k, 1})
+
+    {x, output_weights} =
+      if opts[:weight_inputs], do: {Nx.multiply(x, weights), 1}, else: {x, weights}
 
     project = fn x, kernel -> Nx.dot(x, [1], [0], Nx.take(kernel, experts), [2], [0]) end
     hidden = Nx.multiply(activation.(project.(x, gate)), project.(x, intermediate))
 
     hidden
     |> project.(output)
+    |> Nx.multiply(output_weights)
     |> Nx.reshape({num_tokens, k, :auto})
-    |> Nx.multiply(Nx.new_axis(weights, -1))
     |> Nx.sum(axes: [1])
   end
 
-  defp all_experts(x, weights, experts, gate, intermediate, output, activation) do
+  defp all_experts(x, weights, experts, gate, intermediate, output, activation, opts) do
     num_experts = Nx.axis_size(gate, 0)
 
     # The router weights of every expert, zero for the experts not chosen
@@ -93,13 +99,26 @@ defmodule Bumblebee.Layers do
       |> Nx.multiply(Nx.new_axis(weights, -1))
       |> Nx.sum(axes: [1])
 
-    project = fn x, kernel -> Nx.dot(x, [1], kernel, [2]) end
+    expert_weights = expert_weights |> Nx.transpose() |> Nx.new_axis(-1)
+
+    # Projections are linear, so weighting their outputs weights the input
+    {project, output_weights} =
+      if opts[:weight_inputs] do
+        {fn x, kernel ->
+           x
+           |> Nx.dot([1], kernel, [2])
+           |> Nx.multiply(Nx.transpose(expert_weights, axes: [1, 0, 2]))
+         end, 1}
+      else
+        {fn x, kernel -> Nx.dot(x, [1], kernel, [2]) end, expert_weights}
+      end
+
     hidden = Nx.multiply(activation.(project.(x, gate)), project.(x, intermediate))
 
     hidden
     |> Nx.transpose(axes: [1, 0, 2])
     |> Nx.dot([2], [0], output, [2], [0])
-    |> Nx.multiply(expert_weights |> Nx.transpose() |> Nx.new_axis(-1))
+    |> Nx.multiply(output_weights)
     |> Nx.sum(axes: [0])
   end
 
