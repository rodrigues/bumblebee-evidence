+
+  test ":base with Ministral 3" do
+    assert {:ok, %{model: model, params: params, spec: spec}} =
+             Bumblebee.load_model({:hf, "hf-tiny-v2/tiny-random-Ministral3ForCausalLM"},
+               architecture: :base
