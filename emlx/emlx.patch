diff --git a/emlx/lib/emlx.ex b/emlx/lib/emlx.ex
index 5b873f2..1f22140 100644
--- a/emlx/lib/emlx.ex
+++ b/emlx/lib/emlx.ex
@@ -1347,6 +1347,7 @@ defmodule EMLX do
       cfg.bits,
       cfg.mode
     )
+    |> then(&if(cfg.transpose, do: EMLX.transpose(&1, [1, 0]), else: &1))
     |> EMLX.Backend.to_nx()
