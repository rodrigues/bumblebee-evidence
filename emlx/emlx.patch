diff --git a/emlx/lib/emlx/backend.ex b/emlx/lib/emlx/backend.ex
index 6a9c289..3b13492 100644
--- a/emlx/lib/emlx/backend.ex
+++ b/emlx/lib/emlx/backend.ex
@@ -520,6 +520,22 @@ defmodule EMLX.Backend do
   end
 
   @impl true
+  def transpose(
+        %T{} = out,
+        %T{data: %Backend{quantization_config: %EMLX.Quantization.Config{} = cfg}} = tensor,
+        [1, 0]
+      ) do
+    # Only the logical shape swaps; the flag tells quantized_matmul how to read the packed data
+    transpose = if cfg.transpose, do: nil, else: true
+    %{out | data: %{tensor.data | quantization_config: %{cfg | transpose: transpose}}}
+  end
+
+  def transpose(_out, %T{data: %Backend{quantization_config: %EMLX.Quantization.Config{}}}, axes) do
+    raise ArgumentError,
+          "EMLX.Backend.transpose/3 supports a quantized tensor only of rank 2 with axes [1, 0], " <>
+            "got axes #{inspect(axes)}"
+  end
+
   def transpose(out, tensor, axes) do
     tensor
     |> from_nx()
@@ -1237,6 +1253,14 @@ defmodule EMLX.Backend do
     weight_rank = tuple_size(qw_tensor.shape)
     last_dim = weight_rank - 1
 
+    if cfg.transpose == true and right_axes != [0] do
+      axes = inspect(right_axes)
+
+      raise ArgumentError,
+            "a quantized tensor whose transpose flag is true can be contracted only on its first axis, " <>
+              "got axes #{axes}"
+    end
+
     # If cfg.transpose was explicitly set (e.g. by QuantizeParams when weights are stored
     # in {out,in} physical layout but exposed as {in,out} to Axon), use it; otherwise
